# Minimal meson project overlaid on the data-only magfield git-lfs repository (see
# subprojects/magfield.wrap). It builds nothing and installs nothing on its own; it only exposes
# the directory that holds the CLAS12 field-map .dat files so the parent project can install them.
project('magfield', version : '1.0', meson_version : '>= 1.10.1')

magfield_source_dir = meson.current_source_dir()
