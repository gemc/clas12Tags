[wrap-git]
directory = ccdb
url = https://code.jlab.org/hallb/clas12/ccdb
revision = v1.99.8
depth = 1
clone-recursive = true
method = cmake
# v1.99.8 upstream provides system SQLite support (USE_SYSTEM_SQLITE in meson/meson.build)
