<!--
	Legacy ("old") magnets (torus + solenoid) CAD import, kept for
	old-vs-new comparison. Original engineering tessellations archived in
	cad_original/, with the original per-mesh volume names (CenterTube,
	Hub001, Plate1..6, Shield1..7, coil1..6, shell1a..6b, ...) that the
	optimized cad/ import later merged/renamed and shared via copyOf.
-->

<gxml>
	<volume name="WarmBoreTube"            color="ff8888" material="G4_Al" position="0*mm 0*mm 1273.27*mm" rotation="0*deg 180*deg 0*deg"/>
	<volume name="BoreShield"              color="bb9999" material="G4_STAINLESS-STEEL" position="0*mm 0*mm 1273.27*mm" rotation="0*deg 180*deg 0*deg"/>
